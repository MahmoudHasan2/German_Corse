# Portable desktop copy. "Start German Coach.bat" copies this file to .env on the first run.
# AI keys are entered on the login page (they are saved below automatically).
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8017
SESSION_SECURE_COOKIE=false
LOCAL_MODE=true

DB_HOST=127.0.0.1
DB_PORT=3317
DB_NAME=german_coach
DB_USER=root
DB_PASSWORD=coachlocal

AI_PROVIDER=groq
TUTOR_PROVIDER=groq
STT_PROVIDER=groq
TTS_PROVIDER=browser
GROQ_API_KEY=
GEMINI_API_KEY=
